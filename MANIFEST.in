# distutils' sdist default globs `tests/test*.py`: top level only, and only names starting with
# `test`. conftest.py and the `_*.py` helpers it imports are left behind, so the tree cannot collect.
recursive-include tests *.py
# The goldens read files that are not in the sdist (the corpus is tracked in git, not packaged),
# so they stay out with it; the always-green layer is what an sdist can run.
prune tests/goldens
prune tests/corpus
prune docs/pf-core
prune config/local
# Named, not globbed: an sdist is built from the working tree, where untracked files can sit
# (config/local/ holds a real rig spec; docs/pf-core is a symlink into the venv).
include bin/regen_data.py
include tests/logic/data/send-taper.json tests/logic/data/fader-steps.json
include docs/README.md docs/INSTALLATION.md docs/commands.md docs/CAPABILITIES.md
include config/example-chains.json config/example-mastering.json config/example-psts.json
include config/example-retrack.json config/example-strips.json
include CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md .env.example
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
